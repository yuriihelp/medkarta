{
  "expo": {
    "name": "ПУЛЬС",
    "slug": "puls",
    "version": "1.0.0",
    "scheme": "puls",
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ru.puls.app"
    },
    "android": {
      "package": "ru.puls.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0d9488"
      }
    },
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
